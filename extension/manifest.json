{
  "manifest_version": 3,
  "name": "x-unfollow",
  "version": "1.2.0",
  "description": "Paced bulk unfollow for X. Hard daily cap, protected handles, runs only inside your own browser.",
  "permissions": ["storage"],
  "host_permissions": ["https://x.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "x-unfollow",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
